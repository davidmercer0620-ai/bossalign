{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundaryRule",
  "description": "A source-linked BossAlign rule with explicit applicability and negative boundaries.",
  "type": "object",
  "required": [
    "rule_id",
    "source_event_ids",
    "reviewer",
    "directive",
    "original_feedback",
    "source",
    "evidence",
    "origin",
    "applicable_scope",
    "negative_boundaries",
    "confidence",
    "status",
    "created_at",
    "updated_at",
    "version"
  ],
  "properties": {
    "rule_id": {"type": "string"},
    "source_event_ids": {"type": "array", "items": {"type": "string"}},
    "reviewer": {"type": "string", "minLength": 1},
    "directive": {"type": "string", "minLength": 1},
    "original_feedback": {"type": "string"},
    "source": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "origin": {"type": "string", "enum": ["explicit_instruction", "user_preference", "ai_inference", "hypothesis"]},
    "applicable_scope": {
      "type": "object",
      "properties": {
        "global": {"type": "boolean"},
        "project": {"type": ["string", "array"]},
        "task_type": {"type": ["string", "array"]},
        "topic": {"type": ["string", "array"]},
        "audience": {"type": ["string", "array"]},
        "objective": {"type": ["string", "array"]},
        "task_id": {"type": ["string", "array"]},
        "tags": {"type": ["string", "array"]}
      },
      "additionalProperties": false
    },
    "negative_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {"type": ["string", "array"]},
          "task_type": {"type": ["string", "array"]},
          "topic": {"type": ["string", "array"]},
          "audience": {"type": ["string", "array"]},
          "objective": {"type": ["string", "array"]},
          "task_id": {"type": ["string", "array"]},
          "tags": {"type": ["string", "array"]}
        },
        "minProperties": 1,
        "additionalProperties": false
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["draft", "confirmed", "inactive"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "conflict_key": {"type": "string"},
    "effect": {"type": "string"},
    "deterministic_checks": {"type": "array", "items": {"type": "string"}},
    "confirmed_by": {"type": ["string", "null"]},
    "applicable_topics": {"type": "array", "items": {"type": "string"}},
    "applicable_objectives": {"type": "array", "items": {"type": "string"}},
    "prohibited_topics": {"type": "array", "items": {"type": "string"}},
    "counter_example_rationale": {"type": "string"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeedbackEvent",
  "description": "A source-preserving feedback event used to propose a scoped BossAlign rule.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "reviewer",
    "evidence_level",
    "topic_context",
    "raw_content",
    "extracted_intent",
    "derived_rule_id",
    "source",
    "origin",
    "confidence",
    "attribution",
    "preference_owner",
    "communicative_intent",
    "rule_candidate",
    "sensitive"
  ],
  "properties": {
    "event_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "reviewer": {"type": "string", "minLength": 1},
    "evidence_level": {
      "type": "string",
      "enum": ["L1_DIRECT_QUOTE", "L2_FACTUAL_GROUNDING", "L3_TRANSFERRED_NOTE", "L4_AI_SPECULATION"]
    },
    "topic_context": {"type": "string"},
    "raw_content": {"type": "string"},
    "extracted_intent": {"type": "string"},
    "derived_rule_id": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "origin": {"type": "string", "enum": ["explicit_instruction", "user_preference", "ai_inference", "hypothesis"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "attribution": {"type": "string", "enum": ["direct", "third_party", "ai_inference"]},
    "preference_owner": {"type": ["string", "null"]},
    "communicative_intent": {"type": "string"},
    "rule_candidate": {"type": "boolean"},
    "sensitive": {"type": "boolean"}
  },
  "additionalProperties": false
}
